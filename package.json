{
  "name": "@optimarvin/opti-graphql-client",
  "version": "0.1.3",
  "description": "GraphQL client module for Opti projects",
  "author": "Marvin Oey <marvin.oey@optimizely.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepublishOnly": "yarn build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "keywords": [
    "graphql",
    "client",
    "graphql-client",
    "opti",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marvoey/opti-graphql-client.git"
  },
  "bugs": {
    "url": "https://github.com/marvoey/opti-graphql-client/issues"
  },
  "homepage": "https://github.com/marvoey/opti-graphql-client#readme",
  "dependencies": {
    "crypto-js": "^4.2.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.1",
    "standard-version": "^9.5.0",
    "typescript": "^5.3.3"
  }
}
